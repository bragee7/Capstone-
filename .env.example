# ============================================================
# Internship & Campus Hiring Platform — Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- MySQL connection ---
DB_URL=jdbc:mysql://localhost:3306/campushire?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=campushire
DB_PASSWORD=change_me_dev_only_password

# --- JWT ---
# Generate with: openssl rand -base64 64  (must be >= 32 bytes for HS256)
JWT_SECRET=replace_with_a_secure_secret_at_least_32_chars_long
JWT_EXPIRATION=86400000

# --- Server ---
SERVER_PORT=8080

# --- Frontend origin (CORS) ---
FRONTEND_ORIGIN=http://localhost:5173
